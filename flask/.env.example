# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real secrets.
# Used only in development (ENV_PROD=false). In production, the 2 secrets
# below are provided via Docker secrets (/run/secrets/<name>) instead.

# ───────────────────────── Environment ───────────────────────── #
ENV_PROD=false

# ───────────────────────── Required secrets ──────────────────────── #
# Flask session/CSRF signing key - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme

# https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=changeme
EMAIL_ADDRESS=changeme@gmail.com

# ───────────────────────── Redis ───────────────────────── #
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ───────────────────────── Proxy / Host trust ───────────────────────── #
# Number of reverse-proxy hops in front of Flask (see config.py). Production
# (Cloudflare -> cloudflared -> nginx -> Flask) uses 2 - keep this in sync.
PROXY_TRUSTED_HOP_COUNT=2
EXTERNAL_URL_BASE=http://127.0.0.1:8080

# ───────────────────────── Database reset flags ───────────────────────── #
NEED_TO_RESET_DB_EXCEPT_ACCOUNT=false
NEED_TO_RESET_ALL_DB=false
NEED_TO_RESET_ROLES_PERMISSIONS_TABLES=false

# ───────────────────────── Seeded accounts ───────────────────────── #
CREATE_SEEDED_ACCOUNTS=false

# ───────────────────────── Auth ───────────────────────── #
EMAIL_SUPER_ADMIN=superadmin@medilink.local

# ───────────────────────── Google Sign-In (optional) ───────────────────────── #
# Leave both empty to disable the "Continue with Google" button entirely.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"), with an authorized redirect URI of:
#   http://127.0.0.1:8080/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────────────────── Stripe (NFC card checkout, optional) ───────────────────────── #
# Leave all three empty to disable the shop entirely (STRIPE_ENABLED will be False).
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --print-secret` (Stripe CLI) in dev, or the webhook
# endpoint's "Signing secret" in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=

# Product prices live in the database (shop catalog, editable from the admin
# panel) and are never trusted from the browser. NFC_CARD_PRICE_CENTS only
# seeds the initial MediLink NFC card product on first boot. SHOP_CURRENCY is
# fixed for the whole catalog - Stripe Checkout only supports one currency
# per session.
NFC_CARD_PRICE_CENTS=2999
SHOP_CURRENCY=eur